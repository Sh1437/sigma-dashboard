# ============================================
# SIGMA - Laravel 10
# ============================================

# PHP / Composer dependencies
/vendor/

# Environment files
.env
.env.*
!.env.example

# Laravel generated / runtime files
/storage/*.key
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*

# Keep required storage directories
!/storage/logs/.gitignore
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore

# Laravel public storage symlink
/public/storage

# Laravel cache files
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# Node / NPM
# Walaupun SIGMA memakai Tailwind CDN, ini tetap berguna
# jika package Node tersedia dari instalasi Laravel.
/node_modules/
/public/build
/public/hot

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
.phpunit.result.cache
.phpunit.cache/
.phpunit.cache
coverage/

# Composer authentication
/auth.json

# IDE / Editor
/.idea/
/.vscode/
*.sublime-project
*.sublime-workspace

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Temporary / backup files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Local archives
*.zip
*.rar
*.7z

# Local database files
*.sqlite
*.sqlite3

# Homestead
Homestead.json
Homestead.yaml

# Laravel Sail / Docker local overrides
docker-compose.override.yml